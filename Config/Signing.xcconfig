// Signing for real devices.
//
// A free Apple ID can sign the app onto your own iPhone and iPad, but Xcode
// needs to know which team to sign with. Putting it here rather than in the
// Xcode UI means it survives `xcodegen generate`, which rewrites the project
// file and would otherwise throw the setting away every time a file is added.
//
// Put your team id in Config/Signing.local.xcconfig — that file is ignored by
// git, so your identifier never lands in the repository:
//
//     DEVELOPMENT_TEAM = ABCDE12345
//
// The id is in Xcode ▸ Settings ▸ Accounts, under your Apple ID, in the team
// list; it is also the ten characters Xcode shows beside "Team" in Signing &
// Capabilities.
#include? "Signing.local.xcconfig"
